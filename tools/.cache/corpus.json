 "f_1a56c395": "Ausgezeichnet!",
 "f_6c2dc466": "Bravo!",
 "f_973ca62b": "Gut gemacht!",
 "f_7366abbe": "Weiter so!",
 "f_e8309847": "Du bist ein Zahlenprofi!",
 "f_346dc7a7": "Du rechnest wie ein Meister!",
 "f_12ade3ef": "Dein Kopf ist schneller als ein Taschenrechner!",
 "f_7dc24796": "Zahlen sind deine Freunde!",
