 "f_fbb58bce": "Schau, ich zeige es dir:",
 "f_03a1b0d5": "Probiere es noch einmal.",
 "f_ecc5a578": "Du bist eine Stufe aufgestiegen!",
 "f_a7974a37": "Wir üben es noch ein bisschen leichter.",
 "f_3d00d6c5": "Perfekt!",
 "f_f64dc535": "Bonus-Rubine!",
 "f_7bb069b0": "Du bist jetzt im Plus-Wald.",
 "f_d70ced13": "Du bist jetzt in den Minus-Bergen.",
 "f_d788f52b": "Du bist jetzt in der Mal-Wüste.",
 "f_5c201ec1": "Du bist jetzt in den Teil-Sümpfen.",
 "f_316333ca": "Das ist der Marktplatz.",
 "f_48d080a7": "Von hier kannst du in alle vier Welten laufen.",
 "f_07d0efc2": "Willkommen zurück!",
 "f_228d06f2": "Hier ist es gemütlich.",
 "f_773cded2": "Hallo!",
 "f_e6718f2a": "Schau dir meine Waren an.",
 "f_e120e989": "Das kostet",
 "f_d13adfbe": "Rubine.",
